{
  "name": "lalo-pdf-converter",
  "productName": "Lalo PDF",
  "version": "0.6.2",
  "description": "Lalo PDF",
  "main": "electron/main.js",
  "author": "Lalo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "vendor": "node scripts/copy-vendor.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:win:nsis": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --dir",
    "test:e2e": "electron test/e2e-save.js",
    "test:errors": "electron test/e2e-errors.js",
    "test:markup": "electron test/e2e-annotation.js",
    "test:shapes": "electron test/e2e-shapes.js",
    "test:drag": "electron test/e2e-drag.js",
    "test:reorder": "electron test/e2e-reorder.js",
    "test:print": "electron test/e2e-print.js"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "docx": "^9.16.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.lalo.pdfconverter",
    "productName": "Lalo PDF",
    "copyright": "Copyright © 2026 Lalo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Lalo-PDF-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lalo PDF"
    },
    "portable": {
      "artifactName": "Lalo-PDF-${version}-Portable-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "description": "Documento PDF",
        "mimeType": "application/pdf",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    }
  }
}
